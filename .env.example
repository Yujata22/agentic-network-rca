# Copy this file to `.env` and fill in the values you need before running
# `docker compose up`. `.env` is read automatically by docker compose.
#
# You only need ONE LLM provider key below (whichever you have / prefer).
# No free key yet? GOOGLE_API_KEY (Gemini) has a genuine free tier -- see
# INSTRUCTIONS.md for a 2-minute walkthrough. Using a fully local/open-source
# model (e.g. Ollama) or Hugging Face instead? You don't need any of these
# three -- just wire up the matching LangChain chat model in your agent code.

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACEHUB_API_TOKEN=

# Optional: enable LangSmith tracing. Purely a convenience for your own
# debugging -- it is NOT required and LangSmith is out of scope for this
# challenge (see CHALLENGE.md). Free tier is fine; leave
# LANGCHAIN_TRACING_V2=false if you'd rather not set this up.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# DATABASE_URL -- you normally do NOT need to set this.
#
# When you run inside the provided containers (JupyterLab at :8888, or the
# `jupyter` service), docker-compose already injects the correct value:
#   postgresql://rca_user:rca_password@postgres:5432/network_rca
# (note the host is `postgres`, the compose service name -- NOT localhost).
#
# Only uncomment the line below if you are running code on your HOST machine
# (outside the containers) against the published port 5432, in which case the
# host is `localhost`. Setting it here would otherwise OVERRIDE the correct
# in-container value above and break DB access from inside the container.
#
# DATABASE_URL=postgresql://rca_user:rca_password@localhost:5432/network_rca
